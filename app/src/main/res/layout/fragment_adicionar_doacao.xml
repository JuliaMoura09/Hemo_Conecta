<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/back_foto"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- CABEÇALHO -->
        <LinearLayout
            android:id="@+id/linear_topo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon"
                android:backgroundTint="@color/white">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_back" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adicionar Doação"
                    android:textColor="#111827"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="30dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registre suas últimas doações para saber quando deve realizar a próxima."
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:layout_marginBottom="24dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- DATA DA DOAÇÃO -->
        <TextView
            android:id="@+id/text_data_doacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data da Doação"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/linear_topo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/data_doacao_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="00/00/0000"
            android:textColor="@color/cinza"
            android:textColorHint="@color/cinza"
            android:textSize="18sp"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="@color/white"
            android:padding="18dp"
            android:inputType="date"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/text_data_doacao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TIPO DE DOAÇÃO -->
        <TextView
            android:id="@+id/text_tipo_doacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Que tipo de doação você realizou?"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/data_doacao_input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <RadioGroup
            android:id="@+id/radio_group_doacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/text_tipo_doacao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/option_doacao_sangue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Doação de sangue"/>

            <RadioButton
                android:id="@+id/option_doacao_medula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Doação de medula óssea"/>

            <RadioButton
                android:id="@+id/option_doacao_plaquetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Doação de Plaquetas"/>

            <RadioButton
                android:id="@+id/option_doacao_plasma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Doação de Plasma"/>
        </RadioGroup>

        <!-- LOCAL DA DOAÇÃO -->
        <TextView
            android:id="@+id/text_local_doacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Em que local você realizou a sua doação?"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/radio_group_doacao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Spinner
            android:id="@+id/spinner_local_doacao"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="@color/white"
            android:padding="8dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/text_local_doacao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BOTÃO CADASTRAR -->
        <Button
            android:id="@+id/buttonCadastrarDoacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastrar Doação"
            android:textColor="@color/white"
            android:backgroundTint="@color/vermelho"
            android:padding="18dp"
            android:textSize="18sp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/spinner_local_doacao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>