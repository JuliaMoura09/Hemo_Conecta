<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/back_foto"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/logo" />

        </LinearLayout>

        <TextView
            android:id="@+id/textLogo1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Criar conta"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linear1" />

        <TextView
            android:id="@+id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Junte-se à comunidade de doadores!"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textLogo1" />

        <!--NOME-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text1"
            android:gravity="center"
            android:id="@+id/linear2">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome Completo"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rubi Silva"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/nome_input"
                android:layout_marginTop="12dp"/>

        </LinearLayout>


        <!--CPF-->
        <LinearLayout
            android:id="@+id/linear3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/linear2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPF"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/cpf_input"
                    android:hint="000.000.000-00"
                    android:textColor="@color/cinza"
                    android:textColorHint="@color/cinza"
                    android:textSize="18sp"
                    android:background="@drawable/rounded_corner"
                    android:padding="18dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/white"/>

            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <!--DATA DE NASCIMENTO-->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data de Nascimento"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/nasc_input"
                    android:hint="00/00/0000"
                    android:textColor="@color/cinza"
                    android:textColorHint="@color/cinza"
                    android:textSize="18sp"
                    android:background="@drawable/rounded_corner"
                    android:padding="18dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/white"/>

            </LinearLayout>

        </LinearLayout>

        <!--TIPO SANGUÍNEO-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear3"
            android:gravity="center"
            android:id="@+id/linear4">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo Sanguíneo"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                android:layout_marginTop="12dp"
                android:alignmentMode="alignMargins">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardApositivo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="A+"
                        android:textSize="18sp"
                        android:textColor="@color/cinza"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAnegativo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="A−"
                        android:textSize="18sp"
                        android:textColor="@color/cinza"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBpositivo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="B+"
                        android:textSize="18sp"
                        android:textColor="@color/cinza"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBnegativo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="B−"
                        android:textSize="18sp"
                        android:textColor="@color/cinza"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardABpositivo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="AB+"
                        android:textSize="18sp"
                        android:textColor="@color/cinza"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardABnegativo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="AB−"
                        android:textSize="18sp"
                        android:textColor="@color/cinza"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOpositivo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="O+"
                        android:textSize="18sp"
                        android:textColor="@color/cinza"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOnegativo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="O−"
                        android:textSize="18sp"
                        android:textColor="@color/cinza"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <!--EMAIL-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="E-mail"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="seu@email.com"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/emailCadastro_input"
                android:layout_marginTop="12dp"/>

            <!--SENHA-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="********"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/senhaCadastro_input"
                android:layout_marginTop="12dp"/>

            <!--CONFIRMAR SENHA-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirme sua Senha"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="********"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/senhaConfirmacao_input"
                android:layout_marginTop="12dp"/>

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cadastrar"
                android:textColor="@color/white"
                android:backgroundTint="@color/vermelho"
                android:padding="18dp"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                android:id="@+id/login_bt" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>