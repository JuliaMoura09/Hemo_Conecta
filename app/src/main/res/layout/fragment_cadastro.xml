<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/back_foto"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/logo" />

        </LinearLayout>

        <TextView
            android:id="@+id/textLogo1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ui_criar_conta"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linear1" />

        <TextView
            android:id="@+id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_junte_se_a_comunidade_de_doadores"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textLogo1" />

        <!--NOME-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text1"
            android:gravity="center"
            android:id="@+id/linear2">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_nome_completo"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nome_doador"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/nome_input"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!--CPF-->
        <LinearLayout
            android:id="@+id/linear3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/linear2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_cpf"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/cpf_input"
                    android:hint="@string/ui_000_000_000_00"
                    android:textColor="@color/cinza"
                    android:textColorHint="@color/cinza"
                    android:textSize="18sp"
                    android:background="@drawable/rounded_corner"
                    android:padding="18dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/white"/>

            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <!--DATA DE NASCIMENTO-->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_data_de_nascimento"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/nasc_input"
                    android:hint="@string/data_vazia"
                    android:textColor="@color/cinza"
                    android:textColorHint="@color/cinza"
                    android:textSize="18sp"
                    android:background="@drawable/rounded_corner"
                    android:padding="18dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/white"/>
            </LinearLayout>
        </LinearLayout>

        <!--GÊNERO-->
        <LinearLayout
            android:id="@+id/linear_genero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linear3">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/ui_qual_o_seu_genero"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/radio_group_genero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/option_genero_feminino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_feminino" />

                <RadioButton
                    android:id="@+id/option_genero_masculino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_masculino" />
            </RadioGroup>
        </LinearLayout>

        <!--TIPO SANGUÍNEO-->
        <LinearLayout
            android:id="@+id/linear4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear_genero">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tipo_sanguineo"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                android:layout_marginTop="12dp"
                android:alignmentMode="alignMargins">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardApositivo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/cinza">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/ui_a"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAnegativo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/cinza">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/ui_a_2"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBpositivo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/cinza">


                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/ui_b"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBnegativo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/cinza">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/ui_b_2"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardABpositivo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/cinza">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/ui_ab"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardABnegativo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/cinza">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/ui_ab_2"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOpositivo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/cinza">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/sangue_doador"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOnegativo"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/cinza">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/ui_o"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>
            </GridLayout>

            <!--TIPO DE DOADOR-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_que_tipo_de_doador_voce_e"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <RadioGroup
                android:id="@+id/radio_group_doador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/option_doador_sangue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_sou_apenas_doador_de_sangue"/>

            <RadioButton
                android:id="@+id/option_doador_medula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_sou_apenas_doador_de_medula_ossea"/>

            <RadioButton
                android:id="@+id/option_doador_ambos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_sou_doador_de_sangue_e_de_medula_ossea"/>

            <RadioButton
                android:id="@+id/option_nao_doador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_nao_sou_doador_de_sangue_e_nem_de_medula_ossea"/>
        </RadioGroup>

            <!--EMAIL-->
            <TextView
                android:id="@+id/text_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_e_mail"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/radio_group_doador"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_seu_email_com"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/emailCadastro_input"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/text_email"/>

            <!--SENHA-->
            <TextView
                android:id="@+id/text_senha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_senha"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/emailCadastro_input"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_texto"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/senhaCadastro_input"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/text_senha"/>

            <!--CONFIRMAR SENHA-->
            <TextView
                android:id="@+id/confirmar_senha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_confirme_sua_senha"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/senhaCadastro_input"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_texto"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/senhaConfirmacao_input"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/confirmar_senha"/>

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_cadastrar"
                android:textColor="@color/white"
                android:backgroundTint="@color/vermelho"
                android:padding="18dp"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                android:id="@+id/buttonCadastro"
                app:layout_constraintTop_toBottomOf="@id/senhaConfirmacao_input"/>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>