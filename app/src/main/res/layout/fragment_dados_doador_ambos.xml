<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:fillViewport="true"
    android:background="@drawable/back_foto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/logo" />
        </LinearLayout>

        <TextView
            android:id="@+id/textLogo1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/titulo_dados_doador"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linear1" />

        <!--DATA DE CADASTRO - HEMOES-->
        <LinearLayout
            android:id="@+id/linear2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textLogo1"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/data_hemoes"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/data_vazia"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/data_hemoes_input"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!--REGISTRO DE DOADOR-->
        <LinearLayout
            android:id="@+id/linear3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear2"
            android:gravity="center" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/registro_hemoes"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/registro_vazio"
                android:textColor="@color/cinza"
                android:textColorHint="@color/cinza"
                android:textSize="18sp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/registro_hemoes_input"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!--DATA DE CADASTRO - REDOME-->
        <LinearLayout
            android:id="@+id/linear4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/linear3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/data_redome"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/data_redome_input"
                    android:hint="@string/data_vazia"
                    android:textColor="@color/cinza"
                    android:textColorHint="@color/cinza"
                    android:textSize="18sp"
                    android:background="@drawable/rounded_corner"
                    android:padding="18dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/white"/>
            </LinearLayout>

            <!--REGISTRO DE DOADOR - REDOME-->
            <LinearLayout
                android:id="@+id/linear5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linear4"
                android:gravity="center" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/registro_redome"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="24dp"/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/registro_vazio"
                    android:textColor="@color/cinza"
                    android:textColorHint="@color/cinza"
                    android:textSize="18sp"
                    android:background="@drawable/rounded_corner"
                    android:backgroundTint="@color/white"
                    android:padding="18dp"
                    android:inputType="text"
                    android:id="@+id/registro_redome_input"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/botao_atualizar"
                android:textColor="@color/white"
                android:backgroundTint="@color/red"
                android:padding="18dp"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                android:id="@+id/BtnAtualizar"
                app:layout_constraintTop_toBottomOf="@id/linear4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>