<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp"
            android:background="@color/cor_ffe6e8">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon"
                android:backgroundTint="@color/white">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/ui_voltar"
                    android:src="@drawable/ic_back" />

            </FrameLayout>

            <TextView
                android:id="@+id/categoriaArtigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_categoria_artigo"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/ui_categoria_do_artigo"
                android:textColor="@color/cor_263449"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tituloArtigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ui_titulo_do_artigo"
                android:textColor="@color/cor_202c40"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/autorArtigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ui_nome_do_autor"
                android:textColor="@color/cor_77849a"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_artigo"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_sobre_o_artigo"
                    android:textColor="@color/cor_20385c"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/introducaoArtigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ui_apresentacao_do_assunto_e_dos_principais_pontos_do_arti"
                    android:textColor="@color/cor_70819d"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/conteudoArtigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_artigo"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_entenda_o_assunto"
                    android:textColor="@color/cor_20385c"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoPrincipalArtigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ui_desenvolva_aqui_o_conteudo_do_artigo"
                    android:textColor="@color/cor_70819d"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/dicaArtigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_dica_artigo"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_voce_sabia"
                        android:textColor="@color/cor_20385c"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/curiosidadeArtigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ui_adicione_aqui_uma_curiosidade_relacionada_ao_tema"
                        android:textColor="@color/cor_70819d"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <Button
                android:id="@+id/btnConcluirLeitura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_carregando_leitura"
                android:textColor="@color/white"
                android:backgroundTint="@color/vermelho"
                android:padding="18dp"
                android:textSize="16sp"
                android:enabled="false"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
