<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="55dp"
            android:paddingEnd="22dp"
            android:paddingBottom="25dp">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ola"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/nomeUsuarioInicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_title"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tipoSanguineoInicio"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_quick_red"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_notificacoes"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_buttom_notifications"
                    android:contentDescription="@string/notificacoes"
                    android:padding="12dp"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/text_dark" />

            </LinearLayout>


            <!-- PRÓXIMA DOAÇÃO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_doacao"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRÓXIMA DOAÇÃO DE SANGUE"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/diasProximaDoacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="-- dias"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoProximaDoacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Calculando período..."
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/progressoDoacao"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="90"
                    android:progress="0"
                    android:progressTint="@color/white"
                    android:progressBackgroundTint="#80FFFFFF" />

                <TextView
                    android:id="@+id/btnAgendarAgora"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_agendar"
                    android:text="Agendar agora"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- ACESSO RÁPIDO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/acesso_rapido"
                android:textColor="@color/text_title"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- HISTÓRICO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/historico_bt"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_quick_red"
                        android:padding="17dp"
                        android:src="@drawable/ic_blood"
                        app:tint="@color/quick_red_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/historico"
                        android:textColor="@color/text_dark"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- PROCESSO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/processo_bt"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_quick_blue"
                        android:padding="17dp"
                        android:src="@drawable/ic_document"
                        app:tint="@color/quick_blue_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/processo"
                        android:textColor="@color/text_dark"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- QUESTIONÁRIO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/quest_bt"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_quick_purple"
                        android:padding="17dp"
                        android:src="@drawable/ic_clipboard"
                        app:tint="@color/quick_purple_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/questionario"
                        android:textColor="@color/text_dark"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- DESCONTOS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/cupons_bt"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_quick_yellow"
                        android:padding="17dp"
                        android:src="@drawable/ic_gift"
                        app:tint="@color/quick_yellow_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/descontos"
                        android:textColor="@color/text_dark"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- RANKING DINÂMICO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_ranking"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- TÍTULO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_trophy"
                        app:tint="@color/ranking_gold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/ranking_local"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ver_todos"
                        android:textColor="@color/red"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- POSIÇÕES DINÂMICAS -->
                <LinearLayout
                    android:id="@+id/rankingLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>