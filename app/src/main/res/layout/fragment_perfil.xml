<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/back_foto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Perfil -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/iniciaisPerfil"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_perfil" />

                <!-- Tipo Sanguíneo -->
                <TextView
                    android:id="@+id/tipoSanguineoPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:translationX="25dp"
                    android:translationY="28dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tipo_sanguineo" />
            </FrameLayout>

            <!-- Nome do Usuário -->
            <TextView
                android:id="@+id/nomeUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/cor_20283a"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- E-mail -->
            <TextView
                android:id="@+id/emailUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_description"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="3dp" />


            <!-- Card de Nível e HemoCoins -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_nivel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nivelAtual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_nivel_1"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/nomeNivelAtual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_gota_de_esperanca"
                            android:textColor="@color/quick_red_icon"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/pontosTotais"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_0"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_hemocoins_totais"
                            android:textColor="@color/black"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressoNivel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="250"
                    android:progress="0"
                    android:progressTint="@color/cor_d9302b"
                    android:progressBackgroundTint="@color/white" />

                <TextView
                    android:id="@+id/textoProximoNivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_250_hemocoins_para_o_proximo_nivel"
                    android:textColor="@color/black"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

            <!-- Medalhas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/medalhas"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp" />

            <!-- Primeira Linha de Medalhas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Primeira Gota -->
                <LinearLayout
                    android:id="@+id/medalhaPrimeiraGota"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_medalha">

                    <ImageView
                        android:id="@+id/iconePrimeiraGota"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_blood"
                        android:padding="10dp"
                        android:background="@drawable/bg_icone_medalha"
                        android:backgroundTint="@color/red_light"/>

                    <TextView
                        android:id="@+id/tituloPrimeiraGota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/primeira_medalha"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/descricaoPrimeiraGota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/primeira_medalha_descricao"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <!-- Doador de Plaquetas -->
                <LinearLayout
                    android:id="@+id/medalhaPlaquetas"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_medalha">

                    <ImageView
                        android:id="@+id/iconePlaquetas"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_star"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:backgroundTint="@color/warning_background"
                        android:background="@drawable/bg_icone_medalha" />

                    <TextView
                        android:id="@+id/tituloPlaquetas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/segunda_medalha"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/descricaoPlaquetas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/segunda_medalha_descricao"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <!-- Herói da Medula -->
                <LinearLayout
                    android:id="@+id/medalhaMedula"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_medalha">

                    <ImageView
                        android:id="@+id/iconeMedula"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_heart"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:backgroundTint="@color/red_light"
                        android:background="@drawable/bg_icone_medalha" />

                    <TextView
                        android:id="@+id/tituloMedula"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/terceira_medalha"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/descricaoMedula"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/terceira_medalha_descricao"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Segunda Linha de Medalhas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- Estudioso -->
                <LinearLayout
                    android:id="@+id/medalhaEstudioso"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_medalha">

                    <ImageView
                        android:id="@+id/iconeEstudioso"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_padlock"
                        android:padding="10dp"
                        android:backgroundTint="@color/cor_f1f5f9"
                        android:background="@drawable/bg_icone_medalha" />

                    <TextView
                        android:id="@+id/tituloEstudioso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quarta_medalha"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/descricaoEstudioso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quarta_medalha_descricao"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <!-- Doador Frequente -->
                <LinearLayout
                    android:id="@+id/medalhaFrequente"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_medalha">

                    <ImageView
                        android:id="@+id/iconeFrequente"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_padlock"
                        android:padding="10dp"
                        android:backgroundTint="@color/cor_f1f5f9"
                        android:background="@drawable/bg_icone_medalha" />

                    <TextView
                        android:id="@+id/tituloFrequente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quinta_medalha"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/descricaoFrequente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quinta_medalha_descricao"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <!-- Lenda Viva -->
                <LinearLayout
                    android:id="@+id/medalhaLenda"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_medalha">

                    <ImageView
                        android:id="@+id/iconeLenda"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_padlock"
                        android:padding="10dp"
                        android:backgroundTint="@color/cor_f1f5f9"
                        android:background="@drawable/bg_icone_medalha" />

                    <TextView
                        android:id="@+id/tituloLenda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sexta_medalha"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/descricaoLenda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sexta_medalha_descricao"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botão - Sair da Conta -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="@string/sair_conta"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_botao_sair_conta" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>