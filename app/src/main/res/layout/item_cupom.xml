<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="125dp"
        android:orientation="horizontal">

        <!-- desconto -->
        <LinearLayout
            android:id="@+id/llDiscountBadge"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:background="@drawable/tag_desconto_verde"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDiscountPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_20"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_off"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- informações -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="125dp"
            android:layout_weight="1"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_saude"
                android:textColor="@color/cor_9ca3af"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ui_vita_app_de_saude"
                android:textColor="@color/cor_111827"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCategory" />

            <!-- pontos necessários -->
            <TextView
                android:id="@+id/tvPontosNecessarios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/ui_100_pontos_necessarios"
                android:textColor="@color/cor_6b7280"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <!-- código -->
            <TextView
                android:id="@+id/tvCouponCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_codigo_cupom"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/ui_vitasaude20"
                android:textColor="@color/text_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPontosNecessarios" />

            <!-- copiar -->
            <ImageView
                android:id="@+id/btnCopy"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/ui_copiar_codigo"
                android:src="@drawable/ic_copy"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/tvCouponCode"
                app:layout_constraintStart_toEndOf="@id/tvCouponCode"
                app:layout_constraintTop_toTopOf="@id/tvCouponCode"
                app:tint="@color/cor_e52e2e" />

            <!-- resgatar -->
            <Button
                android:id="@+id/btnResgatar"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/cor_e52e2e"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/ui_resgatar_cupom"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPontosNecessarios" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
